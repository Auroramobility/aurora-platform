# Copy this file to .env.local and fill in the values from your
# Supabase project settings (Project Settings -> API).
# .env.local is gitignored and must never be committed.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Only needed once server-side code requires elevated (RLS-bypassing) access.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
